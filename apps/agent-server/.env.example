# Agent Runtime server. Every value is read at start-up; a missing or weak one stops the server with a message.
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/dbname      # a Postgres with every file in supabase/migrations applied
UPSTREAM_URL=https://your-mcp-server.example/mcp               # the MCP server behind the gateway
GATEWAY_AUDIENCE=recast-gateway                                 # agent tokens must be issued for this audience
PUBLIC_URL=https://runtime.example.com                          # the URL clients call (used to bind DPoP proofs)
PROOF_MODE=required                                             # required | optional | off
ADMIN_TOKEN=                                                    # 24+ characters. Guards /admin/*
RUNTIME_SIGNING_KEY=                                            # Ed25519 private JWK as JSON. Signs the audit log. Keep it in a secrets manager
RUNTIME_KEY_ID=rt-1
RECAST_VAULT={"<tenant uuid>":{"*":"<upstream credential>","google_calendar":"<credential>"}}
