# Recast: Google Calendar sign-in, local only.
# Copy this file to ".env" in this same folder, then paste your values after the "=" signs.
# ".env" is ignored by git: it is never committed. Never paste these values into a chat.

# From Google Cloud Console > APIs & Services > Credentials > your OAuth client ("Web application").
GOOGLE_CLIENT_ID=paste-your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here

# Optional. Leave as is unless port 8787 is taken; if you change it, change the redirect URI in Google to match.
PORT=8787

# Optional: Outlook Calendar. From portal.azure.com > App registrations > your app > Overview > "Application (client) ID".
# The app is a public client (platform "Mobile and desktop applications", redirect http://localhost:8787/microsoft/callback):
# there is no client secret. Leave as is to skip Outlook.
MICROSOFT_CLIENT_ID=paste-your-microsoft-client-id-here
