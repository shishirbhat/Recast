{
  "name": "@recast/desktop",
  "productName": "Recast",
  "version": "0.1.0",
  "description": "Recast: turn what you see into things done.",
  "author": { "name": "Recast", "email": "hello@recast.dev" },
  "homepage": "https://github.com/shishirbhat/Recast",
  "repository": "github:shishirbhat/Recast",
  "desktopName": "recast.desktop",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/build.mjs && node scripts/test.mjs",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac",
    "dist:win": "node scripts/build.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@recast/bridges": "workspace:*",
    "@recast/calendar-link": "workspace:*",
    "@recast/core": "workspace:*",
    "@recast/interaction": "workspace:*",
    "@recast/overlay": "workspace:*",
    "@types/node": "^22.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.56.1",
    "vitest": "^3.2.0"
  }
}
