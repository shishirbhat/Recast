{
  "name": "relay",
  "version": "0.0.1",
  "private": true,
  "description": "Provider-neutral coordination for human developers and coding agents.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "relay": "./bin/relay"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 'test/*.test.ts'",
    "test:real": "RELAY_REAL_PROVIDER=1 node --test --test-concurrency=1 'test/real/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lib0": "^0.2.119",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "y-websocket": "^3.1.0"
  }
}
