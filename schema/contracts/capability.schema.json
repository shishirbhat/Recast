{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recast.dev/schema/1/contracts/capability.schema.json",
  "title": "CapabilityContract",
  "description": "What a destination declares it can accept. A row can raise the grammar's risk, never lower it.",
  "type": "object",
  "required": ["destination", "targetKind", "app", "reliability", "accepts"],
  "additionalProperties": false,
  "properties": {
    "destination": { "type": "string", "minLength": 1 },
    "app": { "type": "string", "minLength": 1 },
    "targetKind": { "enum": ["Event", "Task", "Project", "Message", "Claim", "ResearchPaper", "Product", "Calendar", "Drafts", "TaskList", "Map", "Docs"] },
    "reliability": { "enum": ["native", "official-api", "structured-interface", "deep-link", "ui-automation", "unsupported"] },
    "abilities": {
      "description": "What this destination can do, beyond accepting the rows below. open = opens the app with the details filled in; the person finishes there and Recast cannot see the result. create, read, update, search, delete = calls of the provider's own API. verify = the result can be read back after a write (to confirm, or to check after an unknown outcome). undo = what Recast created or changed can be reversed. Nothing absent from this list is offered.",
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["open", "create", "read", "update", "search", "delete", "verify", "undo"] }
    },
    "accepts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relationId", "effect", "dataMoved"],
        "properties": {
          "relationId": { "type": "string" },
          "effect": { "type": "string", "minLength": 1 },
          "effectFlags": { "type": "array", "uniqueItems": true,
            "items": { "enum": ["send", "delete", "publish", "financial", "modifies-important", "notifies-third-party"] } },
          "risk": { "enum": ["low", "medium", "high"] },
          "reversible": { "type": "boolean" },
          "dataMoved": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z]+\\.[A-Za-z]+$" } }
        }
      }
    }
  }
}
