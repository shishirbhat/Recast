{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recast.dev/schema/1/objects/image.schema.json",
  "title": "ImageProperties",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": { "type": "string", "minLength": 1 }, "alt": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
    "mimeType": { "type": "string" }, "pageUrl": { "type": "string" }
  }
}
