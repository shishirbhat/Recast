{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recast.dev/schema/1/objects/research-paper.schema.json",
  "title": "ResearchPaperProperties",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "authors"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
    "arxivId": { "type": "string" }, "year": { "type": "integer", "minimum": 1000, "maximum": 2100 },
    "venue": { "type": "string" }, "abstract": { "type": "string" },
    "url": { "type": "string" }, "pdfUrl": { "type": "string" }
  }
}
